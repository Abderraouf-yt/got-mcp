{
    "mcpServers": {
        "context7": {
            "command": "npx",
            "args": [
                "-y",
                "@upstash/context7-mcp"
            ],
            "env": {
                "CONTEXT7_API_KEY": "${CONTEXT7_API_KEY}",
                "DEFAULT_MINIMUM_TOKENS": ""
            },
            "description": "Context7 - Documentation and code examples for any programming library or framework"
        },
        "sequential-thinking": {
            "command": "npx",
            "args": [
                "-y",
                "@modelcontextprotocol/server-sequential-thinking"
            ],
            "env": {},
            "description": "Sequential Thinking - Dynamic and reflective problem-solving through thoughts"
        },
        "thought-graph": {
            "command": "node",
            "args": [
                "C:/Users/toumi/Desktop/Development/2026-PROJECTS/thought-graph/dist/index.js"
            ],
            "env": {},
            "description": "Thought Graph - Custom knowledge graph and reasoning system"
        },
        "genkit-mcp-server": {
            "command": "npx",
            "args": [
                "-y",
                "genkit-cli@^1.28.0",
                "mcp",
                "--explicitProjectRoot",
                "--no-update-notification",
                "--non-interactive"
            ],
            "env": {},
            "description": "Genkit MCP Server - Google's AI development framework integration"
        },
        "perplexity-ask": {
            "command": "npx",
            "args": [
                "-y",
                "server-perplexity-ask"
            ],
            "env": {
                "PERPLEXITY_API_KEY": "${PERPLEXITY_API_KEY}"
            },
            "description": "Perplexity Ask - AI-powered search and question answering"
        },
        "puppeteer": {
            "command": "npx",
            "args": [
                "-y",
                "@modelcontextprotocol/server-puppeteer"
            ],
            "env": {},
            "description": "Puppeteer - Browser automation and web scraping capabilities"
        },
        "apify": {
            "command": "npx",
            "args": [
                "-y",
                "@apify/mcp-server"
            ],
            "env": {
                "APIFY_TOKEN": "${APIFY_TOKEN}"
            },
            "description": "Apify - Web scraping and automation platform"
        },
        "tavily": {
            "command": "npx",
            "args": [
                "-y",
                "tavily-mcp@0.2.3"
            ],
            "env": {
                "TAVILY_API_KEY": "${TAVILY_API_KEY}"
            },
            "description": "Tavily - AI-powered search and web content extraction"
        },
        "google-maps-platform-code-assist": {
            "command": "npx",
            "args": [
                "-y",
                "@googlemaps/code-assist-mcp@latest",
                "--transport",
                "stdio"
            ],
            "env": {
                "SOURCE": "antigravity"
            },
            "description": "Google Maps Platform Code Assist - Location-based development tools",
            "disabled": false
        },
        "netlify": {
            "command": "npx",
            "args": [
                "-y",
                "@netlify/mcp"
            ],
            "env": {
                "NETLIFY_AUTH_TOKEN": "${NETLIFY_PERSONAL_ACCESS_TOKEN}"
            },
            "description": "Netlify - Web deployment and hosting platform integration"
        },
        "github-mcp-server": {
            "command": "docker",
            "args": [
                "run",
                "-i",
                "--rm",
                "-e",
                "GITHUB_PERSONAL_ACCESS_TOKEN",
                "ghcr.io/github/github-mcp-server"
            ],
            "env": {
                "GITHUB_PERSONAL_ACCESS_TOKEN": "${GITHUB_PERSONAL_ACCESS_TOKEN}"
            },
            "description": "GitHub MCP Server - GitHub repository management and operations"
        },
        "supabase-mcp-server": {
            "command": "npx",
            "args": [
                "-y",
                "@supabase/mcp-server-supabase@latest",
                "--access-token",
                "${SUPABASE_ACCESS_TOKEN}"
            ],
            "env": {},
            "description": "Supabase - Open Source Firebase alternative",
            "disabled": true
        },
        "n8n-instance": {
            "command": "npx",
            "args": [
                "-y",
                "@modelcontextprotocol/server-http",
                "http://localhost:5678/api/v1/mcp-server/http"
            ],
            "env": {
                "AUTHORIZATION": "Bearer ${N8N_API_KEY}"
            },
            "description": "n8n - Workflow automation tool",
            "disabled": true
        }
    },
    "globalSettings": {
        "timeout": 30000,
        "maxRetries": 3,
        "logLevel": "info"
    },
    "environmentVariables": {
        "CONTEXT7_API_KEY": "Required for Context7 documentation access",
        "PERPLEXITY_API_KEY": "Required for Perplexity AI search",
        "APIFY_TOKEN": "Required for Apify web scraping platform",
        "TAVILY_API_KEY": "Required for Tavily search engine",
        "NETLIFY_PERSONAL_ACCESS_TOKEN": "Required for Netlify deployment",
        "GITHUB_PERSONAL_ACCESS_TOKEN": "Required for GitHub operations",
        "SUPABASE_ACCESS_TOKEN": "Required for Supabase operations (if enabled)",
        "N8N_API_KEY": "Required for n8n integration (if enabled)"
    },
    "notes": {
        "authentication": "All API keys should be set as environment variables, not hardcoded",
        "disabledServers": "Set 'disabled': true to temporarily disable any server",
        "dockerRequirement": "GitHub MCP Server requires Docker to be installed and running",
        "compatibility": "This configuration is compatible with Roo IDE, Gemini CLI, Antigravity, and other MCP-compatible tools"
    }
}